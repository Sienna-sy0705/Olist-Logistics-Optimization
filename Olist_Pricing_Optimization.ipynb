"""Olist logistics-burden analysis and simulated subsidy allocation.

Expected data files in ./data:
  - olist_orders_dataset.csv
  - olist_order_items_dataset.csv
  - olist_order_reviews_dataset.csv
  - olist_customers_dataset.csv
"""

from pathlib import Path

import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns


DATA_DIR = Path(__file__).resolve().parent / "data"
OUTPUT_DIR = Path(__file__).resolve().parent / "outputs"

BUDGET_BRL = 5_000
SUBSIDY_PER_CUSTOMER_BRL = 50
DELIVERY_WEIGHT = 0.70
FREIGHT_WEIGHT = 0.30
TARGET_STATE_COUNT = 5


def min_max_scale(series: pd.Series) -> pd.Series:
    """Scale a numeric series to [0, 1], including constant-series handling."""
    value_range = series.max() - series.min()
    if value_range == 0:
        return pd.Series(0.0, index=series.index)
    return (series - series.min()) / value_range


def load_data(data_dir: Path = DATA_DIR) -> tuple[pd.DataFrame, ...]:
    """Load the four Olist tables required for the analysis."""
    filenames = {
        "orders": "olist_orders_dataset.csv",
        "items": "olist_order_items_dataset.csv",
        "reviews": "olist_order_reviews_dataset.csv",
        "customers": "olist_customers_dataset.csv",
    }

    missing = [name for name in filenames.values() if not (data_dir / name).exists()]
    if missing:
        raise FileNotFoundError(
            "Missing data files in "
            f"{data_dir}: {', '.join(missing)}. "
            "Download the Olist dataset and place these CSVs in the data folder."
        )

    return tuple(pd.read_csv(data_dir / name) for name in filenames.values())


def build_analysis_table(
    orders: pd.DataFrame,
    items: pd.DataFrame,
    reviews: pd.DataFrame,
    customers: pd.DataFrame,
) -> pd.DataFrame:
    """Merge the source tables and engineer logistics features."""
    delivered_orders = orders.loc[orders["order_status"].eq("delivered")].copy()

    date_columns = [
        "order_purchase_timestamp",
        "order_delivered_customer_date",
        "order_estimated_delivery_date",
    ]
    for column in date_columns:
        delivered_orders[column] = pd.to_datetime(
            delivered_orders[column], errors="coerce"
        )

    delivered_orders = delivered_orders.dropna(subset=date_columns)
    delivered_orders["delivery_days"] = (
        delivered_orders["order_delivered_customer_date"]
        - delivered_orders["order_purchase_timestamp"]
    ).dt.total_seconds() / 86_400
    delivered_orders["days_vs_estimate"] = (
        delivered_orders["order_delivered_customer_date"]
        - delivered_orders["order_estimated_delivery_date"]
    ).dt.total_seconds() / 86_400
    delivered_orders["late_delivery"] = delivered_orders["days_vs_estimate"].gt(0)

    review_scores = reviews[["order_id", "review_score"]].drop_duplicates("order_id")

    analysis = (
        delivered_orders.merge(items, on="order_id", how="inner")
        .merge(review_scores, on="order_id", how="left")
        .merge(
            customers[["customer_id", "customer_unique_id", "customer_state"]],
            on="customer_id",
            how="inner",
        )
    )

    required_numeric = ["delivery_days", "freight_value", "price"]
    analysis[required_numeric] = analysis[required_numeric].apply(
        pd.to_numeric, errors="coerce"
    )
    return analysis.dropna(subset=required_numeric + ["customer_state"])


def calculate_state_burden(analysis: pd.DataFrame) -> pd.DataFrame:
    """Create a state-level composite logistics-burden score."""
    state_summary = (
        analysis.groupby("customer_state", as_index=False)
        .agg(
            orders=("order_id", "nunique"),
            avg_delivery_days=("delivery_days", "mean"),
            avg_freight_brl=("freight_value", "mean"),
            late_delivery_rate=("late_delivery", "mean"),
            avg_review_score=("review_score", "mean"),
        )
    )

    state_summary["delivery_norm"] = min_max_scale(
        state_summary["avg_delivery_days"]
    )
    state_summary["freight_norm"] = min_max_scale(
        state_summary["avg_freight_brl"]
    )
    state_summary["burden_score"] = (
        DELIVERY_WEIGHT * state_summary["delivery_norm"]
        + FREIGHT_WEIGHT * state_summary["freight_norm"]
    )

    return state_summary.sort_values("burden_score", ascending=False).reset_index(
        drop=True
    )


def allocate_subsidies(
    analysis: pd.DataFrame, target_states: list[str]
) -> tuple[pd.DataFrame, dict[str, float]]:
    """Simulate a fixed subsidy allocated by historical customer spending."""
    eligible = analysis.loc[analysis["customer_state"].isin(target_states)].copy()

    customer_summary = (
        eligible.groupby("customer_unique_id", as_index=False)
        .agg(
            historical_spend_brl=("price", "sum"),
            orders=("order_id", "nunique"),
            avg_delivery_days=("delivery_days", "mean"),
            avg_freight_brl=("freight_value", "mean"),
        )
        .sort_values("historical_spend_brl", ascending=False)
    )

    capacity = BUDGET_BRL // SUBSIDY_PER_CUSTOMER_BRL
    selected = customer_summary.head(capacity).copy()
    selected["simulated_subsidy_brl"] = SUBSIDY_PER_CUSTOMER_BRL

    total_spend = float(selected["historical_spend_brl"].sum())
    total_subsidy = float(selected["simulated_subsidy_brl"].sum())
    metrics = {
        "selected_customers": float(len(selected)),
        "total_subsidy_brl": total_subsidy,
        "selected_historical_spend_brl": total_spend,
        "spend_to_subsidy_multiple": total_spend / total_subsidy
        if total_subsidy
        else 0.0,
    }
    return selected, metrics


def create_visualizations(
    target_states: pd.DataFrame, metrics: dict[str, float], output_dir: Path
) -> None:
    """Save summary visualizations for the README and project review."""
    output_dir.mkdir(parents=True, exist_ok=True)
    sns.set_theme(style="whitegrid")

    fig, axes = plt.subplots(1, 2, figsize=(14, 5))

    sns.barplot(
        data=target_states,
        x="customer_state",
        y="burden_score",
        hue="customer_state",
        legend=False,
        palette="Reds_r",
        ax=axes[0],
    )
    axes[0].set_title("States with Highest Logistics Burden")
    axes[0].set_xlabel("Customer state")
    axes[0].set_ylabel("Composite burden score")

    comparison = pd.DataFrame(
        {
            "Metric": ["Simulated subsidy", "Historical customer spend"],
            "BRL": [
                metrics["total_subsidy_brl"],
                metrics["selected_historical_spend_brl"],
            ],
        }
    )
    sns.barplot(
        data=comparison,
        x="Metric",
        y="BRL",
        hue="Metric",
        legend=False,
        palette="Blues_d",
        ax=axes[1],
    )
    axes[1].set_title("Simulated Budget vs. Historical Spend")
    axes[1].set_xlabel("")
    axes[1].set_ylabel("BRL")

    for patch in axes[1].patches:
        axes[1].annotate(
            f"{patch.get_height():,.0f}",
            (patch.get_x() + patch.get_width() / 2, patch.get_height()),
            ha="center",
            va="bottom",
            xytext=(0, 5),
            textcoords="offset points",
        )

    fig.tight_layout()
    fig.savefig(output_dir / "olist_logistics_summary.png", dpi=200, bbox_inches="tight")
    plt.close(fig)


def main() -> None:
    orders, items, reviews, customers = load_data()
    analysis = build_analysis_table(orders, items, reviews, customers)
    state_burden = calculate_state_burden(analysis)
    target_states = state_burden.head(TARGET_STATE_COUNT)
    selected, metrics = allocate_subsidies(
        analysis, target_states["customer_state"].tolist()
    )

    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    state_burden.to_csv(OUTPUT_DIR / "state_logistics_burden.csv", index=False)
    selected.to_csv(OUTPUT_DIR / "simulated_subsidy_recipients.csv", index=False)
    create_visualizations(target_states, metrics, OUTPUT_DIR)

    print(f"Analyzed {analysis['order_id'].nunique():,} delivered orders.")
    print("Target states:", ", ".join(target_states["customer_state"]))
    print(f"Selected customers: {int(metrics['selected_customers']):,}")
    print(f"Simulated subsidy: {metrics['total_subsidy_brl']:,.2f} BRL")
    print(
        "Selected customers' historical spend: "
        f"{metrics['selected_historical_spend_brl']:,.2f} BRL"
    )
    print(
        "Historical-spend-to-subsidy multiple: "
        f"{metrics['spend_to_subsidy_multiple']:.1f}x"
    )


if __name__ == "__main__":
    main()
